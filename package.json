{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "Chat App developed with NodeJS and Socket.io",
  "license": "MIT",
  "author": "Lincon Kusunoki",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "smoke": "node smoke.mjs",
    "lint": "oxlint && oxfmt --check .",
    "format": "oxfmt ."
  },
  "dependencies": {
    "bad-words": "^4.1.5",
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
